# Bearer-Token für den MCP-Connector (z.B. openssl rand -hex 32)
MCP_API_KEY=

# Site Manager API Key (unifi.ui.com -> Settings -> API Keys). Wird auch für den
# Cloud-Connector (Konsolen mit mode=cloud) verwendet.
SITE_MANAGER_API_KEY=

# Secrets pro Konsole als ein JSON-Objekt. Die Namen sind die Werte von api_key_env,
# legacy_username_env und legacy_password_env aus consoles.json:
# - Integration-API-Key (mode=direct, in der Network-App der Konsole erstellt)
# - Legacy-API (nur legacy_enabled=true): eigener lokaler Benutzer mit minimalen Rechten
UNIFI_CONSOLE_SECRETS={"UNIFI_KEY_KUNDE_B":"","UNIFI_LEGACY_USER_KUNDE_B":"","UNIFI_LEGACY_PASSWORD_KUNDE_B":""}

# Pfad der Konsolen-Datei auf dem Docker-Host
CONSOLES_FILE_HOST=/srv/unifi-mcp/consoles.json

# MCP-Endpunkt hinter dem Reverse-Proxy, z.B. https://mcp.example.com/unifi
MCP_PATH=/unifi
MCP_BIND_ADDR=0.0.0.0
MCP_HOST_PORT=8439

# Optional
CACHE_TTL_SECONDS=30
AUDIT_RETENTION_DAYS=365
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_AUTH_FAIL_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO
